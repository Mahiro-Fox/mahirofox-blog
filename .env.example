# ============================================================
# 环境变量清单（前端 Next.js + 后端 Go）
# 标注说明：必填 = 缺失时启动/请求直接报错；可选 = 缺失时告警并关闭对应功能
# ============================================================

# ---------- 构建期公开变量（NEXT_PUBLIC_*） ----------
# 会被 next build 字面量内联进客户端产物：docker 部署走 build args，
# 改完必须重新构建镜像（docker compose up -d --build），restart 不会生效。
#
# 必填：站点根地址，不带结尾斜杠，用于 SEO、sitemap、OAuth 回跳等
NEXT_PUBLIC_APP_URL=https://mahirofox.com
# 可选：uploads 静态资源的 R2 自定义域名；留空表示不把 /uploads/* 301 到外部域名
NEXT_PUBLIC_UPLOADS_ORIGIN=https://static.mahirofox.com
# 可选：Cloudflare Turnstile 站点密钥（公开值）。缺失时小部件不渲染，服务端校验一律失败
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---------- 前端服务端运行时 ----------
# 必填：Go 后端内网地址（Next 转发请求用）
GO_API_INTERNAL_URL=http://backend-go:8080
# 必填：与 Go 后端约定的内部共享密钥（X-Internal-Secret）
GO_API_SHARED_SECRET=xxx
# 必填：邮件发送（Resend）密钥。缺失时发送邮件会直接报错
RESEND_API_KEY=xxx
# 必填：邮件发件地址（需与 Resend 已验证域名一致）。缺失时发送邮件会直接报错
EMAIL_FROM=notify@xxx.com
# 必填：DeepSeek 对话密钥
DEEPSEEK_API_KEY=xxx
# 必填：OpenRouter 对话密钥（选择 openrouter 模型时使用）
OPENROUTER_API_KEY=xxx
# 必填：AI Agent 调用本地 Python 工具时的解释器。
# 生产镜像（Dockerfile）已内置 python3 并写入同名环境变量，本地开发按需配置
AGENT_PYTHON=python3

# 可选：人机验证票据的 HMAC 签名密钥（复用 Go 的 JWT_SECRET）。
# 缺失时票据无法签发，同一登录流程的后续步骤会重复要求人机验证（不会放行不该放行的请求）
JWT_SECRET=xxx

# 可选：Google OAuth 登录。缺任一项时登录页隐藏 Google 按钮（线上和本地不一样）
GOOGLE_CLIENT_ID=xxx
GOOGLE_CLIENT_SECRET=xxx
# 可选：OAuth 回调地址；留空时按 `${NEXT_PUBLIC_APP_URL}/next-api/auth/google/callback` 推导
GOOGLE_OAUTH_REDIRECT_URI=

# 可选：WebP 转换质量（1-100）。留空时使用 sharp 自身的默认质量，并输出一次告警
WEBP_QUALITY=50

# ---------- 人机验证（Cloudflare Turnstile） ----------
# 必填：Turnstile 服务端密钥。缺失时校验一律失败（fail-closed）并报错
TURNSTILE_SECRET=
# 必填：siteverify 返回的 hostname 必须命中此列表（逗号分隔，不要带协议和端口）
# 线上域名漏配会让所有验证 fail-closed，表现为“人机验证未通过”
TURNSTILE_HOSTNAMES=localhost,127.0.0.1,mahirofox.com

# ---------- Cloudflare R2（uploads 静态资源） ----------
# 可选：四项齐全才启用 R2；任一缺失时告警并回退本地 uploads 目录（线上和本地不一样）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_ACCESS_KEY=
R2_BUCKET=

# ---------- PostgreSQL ----------
# 必填（后端）：数据库连接参数
DB_HOST=postgres
DB_PORT=5432
DB_USER=xxx
DB_PASSWORD=xxx
DB_NAME=xxx

# 可选（前端）：Mastra 记忆存储连接串。
# 留空时用 DB_* 组装（此时 DB_HOST / DB_PORT / DB_USER / DB_PASSWORD / DB_NAME 变为必填）
MASTRA_PG_URL=postgresql://xxx:xxx@postgres:5432/xxx

# ---------- 后端 Go 运行时 ----------
# 必填：HTTP 监听端口
HTTP_PORT=8080
# 必填：数据目录（容器内通常为 /app/data，用于云音乐 Cookie 等）
DATA_DIR=/app/data
# 必填：会话 JWT 有效期（秒）
SESSION_TTL_SECONDS=86400
# 必填：两类会话 token 的签发者标识，用于隔离前台 / 后台身份
ADMIN_ISSUER=admin:mahirofox
USER_ISSUER=user:mahirofox
# 可选：JWT 验签通过但会话表无记录时是否自动恢复（默认 false）。缺失时告警
SESSION_AUTO_RECOVER=false
