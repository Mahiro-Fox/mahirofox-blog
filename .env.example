# next 前端
# NEXT_PUBLIC_* 会被 next build 内联进客户端产物：docker 部署走 build args，
# 改完必须重新构建镜像（docker compose up -d --build），restart 不会生效
NEXT_PUBLIC_APP_URL=http://localhost:3000
# uploads 静态资源的 R2 自定义域名（留空则不做 /uploads 301）
NEXT_PUBLIC_UPLOADS_ORIGIN=
RESEND_API_KEY=xxx
EMAIL_FROM=notify@xxx.com
ADMIN_DEFAULT_PASSWORD=xxx
DEEPSEEK_API_KEY=xxx
OPENROUTER_API_KEY=xxx

# Google OAuth 登录（Google Cloud Console 创建的 OAuth 2.0 客户端）
# 回调地址默认 ${NEXT_PUBLIC_APP_URL}/next-api/auth/google/callback，需要与 Google 控制台配置一致
GOOGLE_CLIENT_ID=xxx
GOOGLE_CLIENT_SECRET=xxx
GOOGLE_OAUTH_REDIRECT_URI=

# Go 后端
HTTP_PORT=8080
GO_API_INTERNAL_URL=http://localhost:8080
GO_API_SHARED_SECRET=xxx

# PostgreSQL 配置
DB_HOST=postgres
DB_PORT=5432
DB_USER=xxx
DB_PASSWORD=xxx
DB_NAME=xxx

# 公共配置
JWT_SECRET=xxx

# Cloudflare R2（uploads 静态资源；留空时退回本地 uploads 目录）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_ACCESS_KEY=
R2_BUCKET=

# Cloudflare Turnstile 人机验证
# 站点密钥可公开（会出现在前端）；密钥只能在服务端使用，切勿提交到仓库
# 注意：NEXT_PUBLIC_* 在 next build 时内联，docker 构建需通过 build args 传入
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# siteverify 返回的 hostname 必须命中此列表（逗号分隔，不要带协议和端口）
# 线上域名漏配会让所有验证 fail-closed，表现为"人机验证未通过"
TURNSTILE_HOSTNAMES=localhost,127.0.0.1,mahirofox.com
